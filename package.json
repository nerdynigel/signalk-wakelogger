{
  "name": "signalk-wakelogger",
  "version": "0.2.0-beta.1",
  "description": "Send live Signal K vessel data to Wake Logger for tracking, trip replay and sailing performance analysis",
  "license": "Apache-2.0",
  "author": "Nigel George",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerdynigel/signalk-wakelogger.git"
  },
  "bugs": {
    "url": "https://github.com/nerdynigel/signalk-wakelogger/issues"
  },
  "homepage": "https://wakelogger.com/",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-cloud",
    "signalk",
    "marine",
    "sailing",
    "gps",
    "vessel-tracking",
    "trip-log",
    "telemetry",
    "mqtt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:broker": "vitest run test/integration/mqtt-broker.test.ts",
    "test:docker": "node scripts/test-signalk-docker.mjs",
    "test:watch": "vitest",
    "lint": "eslint src test scripts --max-warnings=0",
    "check:public": "node scripts/check-public-repo.mjs",
    "measure:protocol": "node scripts/measure-protocol.mjs",
    "measure:outbox": "npm run build && node scripts/measure-outbox.mjs",
    "prepublishOnly": "node scripts/verify-release.mjs && npm run check",
    "check": "npm run check:public && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.31.1",
    "@types/node": "^20.17.30",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  },
  "signalk": {
    "displayName": "Wake Logger",
    "appIcon": "./assets/wakelogger.png",
    "screenshots": [
      "./assets/screenshots/plugin-status.png",
      "./assets/screenshots/plugin-config.png"
    ]
  },
  "signalk-plugin-enabled-by-default": false
}
